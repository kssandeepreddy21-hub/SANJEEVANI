# RESQ-AI Environment Configuration Example
# Copy to .env and adjust values as needed. Do not commit .env files.

# Directory containing external Bengaluru OSM data:
#   <RESQ_AI_DATA_DIR>/processed/bengaluru_osm.graphml
#   <RESQ_AI_DATA_DIR>/processed/bengaluru_osm_cached.pkl
#   <RESQ_AI_DATA_DIR>/raw/planet_77.46_12.907_d3d9fd17.osm.pbf
RESQ_AI_DATA_DIR=

# Backend mode: "synthetic" (default) or "osm" (Real Bengaluru OSM Mode)
RESQ_AI_MODE=synthetic

